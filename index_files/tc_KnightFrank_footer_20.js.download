executeTag1124_4398_20: function (el, p){
if (!el||!el.target){el={type:"no_event",target:{}}};
if(typeof p=="undefined"){p={};}
tc_array_events = tC.container_4398_20.init_tc_array_events(p);
var cact = tC.container_4398_20.cact || window.cact;
var cact_container = window.tC_4398_20;
var cact_event = el || {};
var cact_event_vars = Object.assign({}, tc_array_events);
var cact_event_attrs = cact_event.target || {};
// *** KF | Generic Event Calls | DOM Ready - The View ***
(function (window){
// Get all elements with the class "btn-animated"
const btnElements = document.querySelectorAll('.btn-animated');
// Define the event listener function
function handleButtonClick(event) {
// This function will be called when a "btn-animated" element is clicked
// Find the closest parent element with the class "cta-block"
const ctaBlock = event.target.closest('.cta-block');
// Find the child element with the class "cta-block__title" within the "cta-block"
const ctaTitle = ctaBlock.querySelector('.cta-block__title');
// Get the text value of the "cta-block__title" element
const titleText = ctaTitle.textContent;
// Get the text value of the clicked "btn-animated" element
const buttonText = document.querySelector('.btn-animated__span-inner').textContent;
// Get the href attribute of the link within the "cta-block"
const link = ctaBlock.querySelector('a');
const hrefValue = link ? link.getAttribute('href') : '';
// Log the text value and href to the console
//   tC.log('Button clicked! Button Title:', buttonText);
//  tC.log('Button clicked! CTA Title:', titleText);
//  tC.log('Link href:', hrefValue);
var obj = {
send_to: tC.internalvars.GA4_by_domain,
'content_group': "The View",
'link_text': titleText,
'link_url': hrefValue
};
// Gtag for 'Contact Us' clicks on The View
if (buttonText === "Contact us" && window.gtag) {
gtag("event", "the_view_contact_us_click", obj);
}
// Gtag for 'Find Out More' clicks on The View
if (buttonText === "Find out more" && window.gtag) {
gtag("event", "the_view_find_out_more_click", obj);
}
}
// Add the event listener to each "btn-animated" element
btnElements.forEach((element) => {
element.addEventListener('click', handleButtonClick);
});
if (window.scriptTriggered) {
return; // Exit the function if already triggered
}
// Add a click event listener to the document or a container element
document.addEventListener('click', function (event) {
// For older versions of Internet Explorer
if (!event) {
event = window.event;
}
// Check if the clicked element is a link (<a> tag)
const target = event.currentTarget;
if (event.target.tagName === 'A' || event.target.closest('a')) {
const link = event.target.closest('a');
const href = link.getAttribute('href');
//Define obj for Google Analytics variables
var obj = {
send_to: tC.internalvars.GA4_by_domain,
'content_group': "The View",
'link_url': href
};
// Check various conditions and log events
if (href && href.includes('/contact/people/')) {
//   tC.log('Clicked on a link with /contact/people/ in the URL:', href);
if (window.gtag) {
gtag("event", "the_view_contact_person_click", obj);
}
}
if (href && href.includes('/contact/offices/')) {
//     tC.log('Clicked on a link with /contact/offices/ in the URL:', href);
if (window.gtag) {
gtag("event", "the_view_contact_office_click", obj);
}
}
if (href && href.includes('publications.knightfrank')) {
//    tC.log('Clicked on a link with publications.knightfrank in the URL:', href);
if (window.gtag) {
gtag("event", "the_view_publications_click", obj);
}
}
if (href && (href.includes('properties/residential/') || href.includes('properties/commercial/'))) {
//    tC.log('Clicked on a link with residential OR commercial & properties in the URL:', href);
if (window.gtag) {
gtag("event", "the_view_property_details_click", obj);
}
}
if (href && href.includes('property-for-sale')) {
//   tC.log('Clicked on a link with "property-for-sale" in the URL:', href);
if (window.gtag) {
gtag("event", "the_view_property_for_sale_click", obj);
}
}
if (href && !(href.includes('properties')) && (href.includes('residential/') || href.includes('commercial/'))) {
//    tC.log('Clicked on a link with residential OR commercial & NOT properties in the URL:', href);
if (window.gtag) {
gtag("event", "the_view_service_line_click", obj);
}
}
if (href && href.includes('how-much-is-your-property-worth')) {
//     tC.log('Clicked on a link with how-much-is-your-property-worth in the URL:', href);
if (window.gtag) {
gtag("event", "the_view_appraisal_click", obj);
}
}
if (href && href.includes('mailto')) {
//    tC.log('Clicked on a link with mailto in the URL:', href);
if (window.gtag) {
gtag("event", "the_view_mailto_click", obj);
}
}
if (href && href.includes('?=tvl')) {
//    tC.log('Clicked on a link with ?=tvl in the URL:', href);
if (window.gtag) {
gtag("event", "the_view_insights_click", obj);
}
}
if (href && href.includes('.pdf')) {
//     tC.log('Clicked on a link with a PDF in the URL:', href);
if (window.gtag) {
gtag("event", "the_view_pdf_download", obj);
}
}
if (href && !(href.includes('knightfrank'))) {
//    tC.log('Clicked on a link with an external URL:', href);
if (window.gtag) {
gtag("event", "the_view_outbound_click", obj);
}
}
}
});
window.scriptTriggered = true;
})(window);
}
});
