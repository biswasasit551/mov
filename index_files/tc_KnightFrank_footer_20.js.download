tC.launchTag(1490, 'Container Loaded | ChatGPT / AI Links', 26, 4398, 20, 9);
// *** Container Loaded | ChatGPT / AI Links ***
(function(){
const referrer = document.referrer;
const referrerMap = [
{
match: /chatgpt\.com/,
utms: {
utm_source: "chatgpt",
utm_medium: "ai",
utm_campaign: "chatgpt_referral"
}
},
{
match: /claude\.ai/,
utms: {
utm_source: "claude",
utm_medium: "ai",
utm_campaign: "claude_referral"
}
},
{
match: /perplexity\.ai/,
utms: {
utm_source: "perplexity",
utm_medium: "ai",
utm_campaign: "perplexity_referral"
}
},
{
match: /gemini\.google\.com/,
utms: {
utm_source: "gemini",
utm_medium: "ai",
utm_campaign: "gemini_referral"
}
}
// Add more AI tools as needed
];
const matchedTool = referrerMap.find(tool => referrer && tool.match.test(referrer));
if (!matchedTool) return;
const cleanAndApplyUTMs = function(utmParams){
const url = new URL(window.location.href);
// Remove all existing UTM parameters
for (const key of [...url.searchParams.keys()]){
if (key.startsWith('utm_')){
url.searchParams.delete(key);
}
}
// Apply the new UTM parameters
for (const [key, value] of Object.entries(utmParams)){
url.searchParams.set(key, value);
}
const newUrl = url.toString();
if (newUrl !== window.location.href){
window.location.replace(newUrl);
}
};
cleanAndApplyUTMs(matchedTool.utms);
})();


