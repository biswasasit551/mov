// *** Privacy Banner | EAA | Desktop ***
setTimeout(function(){
var setupPrivacyCenterFocus = function(){
try {
// Check if modal is open
if (document.body.classList.contains('tc-modal-open')){
const observer = new IntersectionObserver((entries, observer) => {
entries.forEach(entry => {
if (entry.isIntersecting){
// Focus and clean up
entry.target.focus();
observer.disconnect();
}
});
}, { threshold: 0.1 });
const element = document.querySelector('.tc-open-privacy-center');
if (element) observer.observe(element);
}
} catch (error){
tC.error('TagCommander focus handler error:', error);
}
};
setupPrivacyCenterFocus();
if (typeof MutationObserver !== 'undefined'){
const domObserver = new MutationObserver((mutations) => {
mutations.forEach(() => {
if (document.body.classList.contains('tc-modal-open')){
setupPrivacyCenterFocus();
}
});
});
domObserver.observe(document.body, { attributes: true });
}},1250);
}
});
