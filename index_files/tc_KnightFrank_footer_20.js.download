tC.extend({
executeTag1164_4398_20: function (el, p){
if (!el||!el.target){el={type:"no_event",target:{}}};
if(typeof p=="undefined"){p={};}
tc_array_events = tC.container_4398_20.init_tc_array_events(p);
var cact = tC.container_4398_20.cact || window.cact;
var cact_container = window.tC_4398_20;
var cact_event = el || {};
var cact_event_vars = Object.assign({}, tc_array_events);
var cact_event_attrs = cact_event.target || {};
// *** DOM Ready - Intelligence Lab - Article Search Term ***
var referrer = document.referrer;
var decodeQueryParam = function(param){
return decodeURIComponent(param.replace(/\+/g, ' '));
};
var getQueryParam = function(url, param){
var queryString = url.split('?')[1];
if (!queryString){
return null;
}
var queryParams = queryString.split('&');
for (var i = 0; i < queryParams.length; i++){
var pair = queryParams[i].split('=');
if (pair[0] === param){
return decodeQueryParam(pair[1]);
}
}
return null;
};
var queryParameter = getQueryParam(referrer, 'query');
if (queryParameter !== null){
tc_vars.search_input = queryParameter
}
}
});
tC.extend({
executeTag724_4398_20: function (el, p){
