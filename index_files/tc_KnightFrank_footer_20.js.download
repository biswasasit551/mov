},57000);
window.addEventListener("scroll", checkScroll, false);
var getTrackLength = function() {
const { body, documentElement } = document;
const winheight = window.innerHeight || (documentElement || body).clientHeight
const docheight = Math.max(
body.scrollHeight, documentElement.scrollHeight,
body.offsetHeight, documentElement.offsetHeight,
body.clientHeight, documentElement.clientHeight
);
return docheight - winheight;
};
var getScrollTop = function() {
return window.pageYOffset || (document.documentElement || document.body.parentNode || document.body).scrollTop;
};
let previousValue = 0;
var checkScroll = function() {
const trackLength = getTrackLength();
const scrollTop = getScrollTop();
const percent = Math.floor(scrollTop / trackLength * 100) 
//tC.log({ percent, previousValue });
if (percent === 50 && previousValue < 50) {
if (tc_vars.page_engaged !== "Yes"){
if (window.gtag){
var obj = {
send_to: tC.internalvars.GA4_by_domain,
'page_location': page_lookup,
'content_group': content_group,
'user_action': "Scroll > 50%",
'day_number': tc_vars.day_number, 
'day_of_week': tc_vars.day_of_week, 
'hour_of_day': tc_vars.hour_of_day, 
'timezone_location': tc_vars.timezone_location
}
gtag("event","page_engagement", obj);
}
tc_vars.page_engaged = "Yes";}
clearTimeout(timeOut);
previousValue = percent + 1
}
};
window.addEventListener("scroll", checkScroll, false);
const button = document.querySelectorAll('a[class*="button"], button[class*="ng-star-inserted"], div[class*="js-sidebar-open"], input[id*="txtSearch"], a[href*="/"], a[href*=".pdf"], button[class*="btn"], button[data-link*="enquiry form"], button[class*="search-button"]');
var numButton = button.length;
var clickButton = function() {
if (tc_vars.page_engaged !== "Yes"){
setTimeout(function(){
if (window.gtag){
var obj = {
send_to: tC.internalvars.GA4_by_domain,
'page_location': page_lookup,
'content_group': content_group,
'user_action': "CTA Clicked",
'day_number': tc_vars.day_number, 
'day_of_week': tc_vars.day_of_week, 
'hour_of_day': tc_vars.hour_of_day, 
'timezone_location': tc_vars.timezone_location
}
gtag("event","page_engagement", obj);
}},7000);
tc_vars.page_engaged = "Yes";}
for (var i = 0; i < numButton; i++) {
button[i].removeEventListener('click', clickButton);
window.removeEventListener("scroll", checkScroll)
clearTimeout(timeOut);
}
};
for (var i = 0; i < numButton; i++) {
button[i].addEventListener('click', clickButton), {once : true}
}}
}
