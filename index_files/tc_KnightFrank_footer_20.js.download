window.addEventListener('load', function(){
// Select the link using a suitable selector
var link = document.querySelector('a[href="https://content.knightfrank.com/resources/knightfrank.com/private-office/private-office---brochure---london.pdf"]');
if (link){
// Add an event listener to the link
