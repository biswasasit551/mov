// *** GA4 | Pageview | Session Expiry  ***
if (!window.__ga_session_checker_loaded){
window.__ga_session_checker_loaded = true;
// All your code goes inside this block!
setTimeout(function(){
const ONE_HOUR = 60 * 60 * 1000;
let intervalId = null;
var getCookieValue = function(name){
const cookies = document.cookie.split(';');
for (let i = 0; i < cookies.length; i++){
const cookie = cookies[i].trim();
if (cookie.startsWith(name + '=')){
return cookie.substring(name.length + 1);
}
}
return null;
};
var getSessionId = function(measurementId){
const cookieName = `_ga_${measurementId}`;
const gaCookie = getCookieValue(cookieName);
if (gaCookie && gaCookie.startsWith("GS2.1.")){
const parts = gaCookie.split('.');
if (parts.length > 2){
const sessionSegment = parts[2];
const match = sessionSegment.match(/^s(\d+)/);
if (match && match[1]){
return match[1];
}
}
}
return null;
};
var checkSession = function(){
try {
if (typeof tC === "undefined" || !tC.internalvars){
return;
}
let measurementId = tC.internalvars.GA4_by_domain || null;
let sessionId = measurementId ? getSessionId(measurementId.replace("G-", "")) : null;
if (!sessionId) return;
if (!window.tc_vars || typeof window.tc_vars !== "object"){
window.tc_vars = {};
}
const storedSession = sessionStorage.getItem('ga_session_id') || null;
const storedTimestamp = Number(sessionStorage.getItem('stored_timestamp')) || 0;
const now = Date.now();
if (!storedSession || storedSession !== sessionId || (now - storedTimestamp) > ONE_HOUR){
sessionStorage.setItem('ga_session_id', sessionId);
sessionStorage.setItem('stored_timestamp', now);
triggerCustomEvent();
if (intervalId !== null){
clearInterval(intervalId);
intervalId = null;
tC.log("Interval cleared after session ID change.");
}
}
} catch (error){
tC.error("Error in checkSession:", error);
}
};
var triggerCustomEvent = function(){
if (typeof tC !== "undefined" && typeof tC.launchTag === "function"){
if (window.gtag){
gtag('event', 'page_view', {});
}
}
};
checkSession();
intervalId = setInterval(checkSession, 600000);
}, 4000);
}
}
});
