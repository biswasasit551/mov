} else if (url.includes("/residential") && !url.includes("/prime-residential")) {
tc_vars.content_group = "Residential Service Line";
} else if (url.includes("/residential") && url.includes("/prime-residential")) {
tc_vars.content_group = "Prime Residential Service Line";
} else if (url.includes("/consulting")) {
tc_vars.content_group = "Consulting Service Line";
} else if (url.includes("/project-development-services")) {
tc_vars.content_group = "Project Development Service Line";
} else if (url.includes("/valuation-advisory")) {
tc_vars.content_group = "Valuation & Advisory Service Line";
}
}
});
