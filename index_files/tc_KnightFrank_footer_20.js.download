ga4_event_name = "cms_contact_agent_open"}
else if(tc_array_events["form_status"] === "form.submit.success" && tc_array_events["form_name"] === "CMS - Contact Agent Form"){
page_path = window.location.pathname+'/cms-contact-agent/thank-you'
