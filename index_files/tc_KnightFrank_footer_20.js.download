var cact_event_vars = Object.assign({}, tc_array_events);
var cact_event_attrs = cact_event.target || {};
// *** GA4 Config | PageView with Custom Dimensions - Resi Portal ***
// gtag stub (idempotent — sitewide consent tag also sets this; kept for safety)
window.dataLayer = window.dataLayer || [];
window.gtag = window.gtag || function(){ dataLayer.push(arguments); };
function loadGTM() {
if (!window.gtagLoaded) {
window.gtagLoaded = true;
var script = document.createElement("script");
script.src = "https://www.googletagmanager.com/gtag/js?id="+tC.internalvars.GA4_by_domain;
script.async = true;
document.head.appendChild(script);
gtag('js', new Date());
}
}
loadGTM();
tc_vars.content_group = "MyKnightFrank";
if(tc_vars.activity_id === ''){
tc_vars.activity_id = tc_array_events.activity_id;}
tC.internalvars.GA4_pagelocation = window.document.URL.replace('&&','&').replace(new RegExp('[?&]' + '(_its|infinity|ID|locale)' + '=[^&#]*(#.*)?$'), '$1').replace(new RegExp('([?&])' + '(_its|infinity|ID|locale)' + '=[^&]*&'), '$1').replace(new RegExp('_its'), '');
page_location = tC.internalvars.GA4_pagelocation;
if(location.search.indexOf('utm_source') !== -1 && location.search.indexOf('utm_medium') !== -1 && location.search.indexOf('utm_campaign') !== -1 && location.search.indexOf('utm_content') === -1){
var url = new URL(window.document.URL);
gtag('set', {
'campaign_source': url.searchParams.get("utm_source").replace("%20"," "),
'campaign_medium': url.searchParams.get("utm_medium").replace("%20"," "),
'campaign_name': url.searchParams.get("utm_campaign").replace("%20"," ")
});
} 
if(location.search.indexOf('utm_source') !== -1 && location.search.indexOf('utm_medium') !== -1 && location.search.indexOf('utm_campaign') !== -1 && location.search.indexOf('utm_content') !== -1){
var url = new URL(window.document.URL);
gtag('set', {
'campaign_source': url.searchParams.get("utm_source").replace("%20"," "),
'campaign_medium': url.searchParams.get("utm_medium").replace("%20"," "),
'campaign_name': url.searchParams.get("utm_campaign").replace("%20"," "),
'campaign_content': url.searchParams.get("utm_content").replace("%20"," ")
});
} 
gtag('set', 'allow_ad_personalization_signals', false);
gtag('set', 'allow_google_signals', false);
gtag('consent', 'update', {
'analytics_storage': 'granted'
});
if(tc_array_events["hubID"] !== ""){
gtag('set', 'user_properties', {
'hub_contact_id': tc_array_events["hubID"],
'b2c_account_id': tc_array_events["account_id"]
}
);
tc_vars.hub_contact_id = tc_array_events["hubID"]
tc_vars.b2c_account_id = tc_array_events["account_id"]
} 
else {
gtag('set', 'user_properties', {
'hub_contact_id': tc_vars.hubID,
'b2c_account_id': tc_vars.accountID
}
)
tc_vars.hub_contact_id = tc_vars.hubID
tc_vars.b2c_account_id = tc_vars.accountID
}
var isPageViewSending = false;
if (!isPageViewSending){
isPageViewSending = true;
// Send the page_view event to GA4
gtag('event', 'page_view', {
'send_to': tC.internalvars.GA4_by_domain,
'page_title': window.document.title,
'page_location':  window.document.URL.replace('&&','&').replace(new RegExp('[?&]' + '(_its|infinity|ID|locale)' + '=[^&#]*(#.*)?$'), '$1').replace(new RegExp('([?&])' + '(_its|infinity|ID|locale)' + '=[^&]*&'), '$1').replace(new RegExp('_its'), ''), 
'hub_contact_id': tc_vars.hub_contact_id,
'b2c_account_id': tc_vars.b2c_account_id,
'hub_activity_id': tc_array_events["activity_id"],
'hub_tenancy_id': tc_array_events["tenancy_id"],
'hub_appointment_id': tc_array_events["appointment_id"],
'hub_company_id': tc_array_events["company_id"],
'hub_instruction_id': tc_array_events["instruction_id"], 
'hub_offer_id': tc_array_events["offer_id"],
'hub_property_reference': tc_array_events["property_reference"],
'hub_requirement_id': tc_array_events["requirement_id"],
'hub_user_type': tc_vars.user_type,
'content_group' : tc_vars.content_group,
'PageHitNumber': tc_vars.session_pageview_count
});
}
}
});
