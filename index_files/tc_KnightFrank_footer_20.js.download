tC.extend({
executeTag1150_4398_20: function (el, p){
if (!el||!el.target){el={type:"no_event",target:{}}};
if(typeof p=="undefined"){p={};}
tc_array_events = tC.container_4398_20.init_tc_array_events(p);
var cact = tC.container_4398_20.cact || window.cact;
var cact_container = window.tC_4398_20;
var cact_event = el || {};
var cact_event_vars = Object.assign({}, tc_array_events);
var cact_event_attrs = cact_event.target || {};
// *** PLP - Search Location - City Keyword & Bedrooms/Bathrooms ***
(function () {
// Extract location from search_keywords string
const tc_search_extractText = function(inputString) {
const tc_search_keywords = [
'for sale in', 'for rent in', 'closest properties to',
'properties for rent and to lease in', 'properties for sale in',
'Immobilien zur Miete in', 'Gewerbeimmobilien zum Verkauf in', 'Gewerbeimmobilien zur Miete in',
'Immobilien zur Miete in', 'Propriété à louer en', 'Propriétés disponibles à',
'Propriété à vendre en', 'Propriété à louer en', 'Inmuebles en renta en',
'Inmuebles en venta en', 'Inmuebles comerciales en venta o renta', 'Inmuebles en renta en'
];
if (typeof inputString !== "string") return "";
for (const keyword of tc_search_keywords) {
const index = inputString.indexOf(keyword);
if (index !== -1) {
let extracted = inputString.substring(index + keyword.length).trim();
extracted = extracted.replace(/[.,\/#!$%\^&\*;:{}=\-_`~()]/g, "").trim();
return extracted;
}
}
return "";
};
// Handle search_keywords to location extraction
const tc_search_inputString = tc_vars?.properties_searched?.[0]?.search_keywords || null;
const tc_search_result = tc_search_extractText(tc_search_inputString);
tc_vars.search_location = tc_search_result;
// Bedrooms logic
const tc_searchBedroomsMin = tc_vars?.properties_searched?.[0]?.search_bedroomsMin ?? '';
const tc_searchBedroomsMax = tc_vars?.properties_searched?.[0]?.search_bedroomsMax ?? '';
if (tc_searchBedroomsMin === '' && tc_searchBedroomsMax === '') {
tc_vars.search_bedrooms = "Any Bedrooms";
} else if (tc_searchBedroomsMin >= 1 && tc_searchBedroomsMax === '') {
tc_vars.search_bedrooms = "Min " + tc_searchBedroomsMin + " Bedrooms";
} else if (tc_searchBedroomsMin === '' && tc_searchBedroomsMax >= 1) {
tc_vars.search_bedrooms = "Max " + tc_searchBedroomsMax + " Bedrooms";
} else if (tc_searchBedroomsMin !== '' && tc_searchBedroomsMax !== '' && tc_searchBedroomsMin === tc_searchBedroomsMax) {
tc_vars.search_bedrooms = "Max " + tc_searchBedroomsMax + " Bedrooms";
} else if (tc_searchBedroomsMin !== tc_searchBedroomsMax && tc_searchBedroomsMin >= 1 && tc_searchBedroomsMax >= 1) {
tc_vars.search_bedrooms = tc_searchBedroomsMin + " to " + tc_searchBedroomsMax + " Bedrooms";
}
// Bathrooms logic
const tc_searchBathroomsMin = tc_vars?.properties_searched?.[0]?.search_bathroomsMin ?? '';
if (tc_searchBathroomsMin === '') {
tc_vars.search_bathrooms = "Any Bathrooms";
} else if (tc_searchBathroomsMin >= 1) {
tc_vars.search_bathrooms = "Min " + tc_searchBathroomsMin + " Bathrooms";
}
// Property country logic
const tc_propertyCountry = tc_vars?.property_details?.[0]?.property_country;
tc_vars.search_location_country = tc_propertyCountry ?? null;
})();
}
});
tC.extend({
executeTag1513_4398_20: function (el, p){
if (!el||!el.target){el={type:"no_event",target:{}}};
if(typeof p=="undefined"){p={};}
tc_array_events = tC.container_4398_20.init_tc_array_events(p);
var cact = tC.container_4398_20.cact || window.cact;
var cact_container = window.tC_4398_20;
var cact_event = el || {};
var cact_event_vars = Object.assign({}, tc_array_events);
var cact_event_attrs = cact_event.target || {};
// *** GA4 Config | Pageview with Custom Dimensions - PLP (Improved Script) ***
(function() {
// gtag stub (idempotent — sitewide consent tag also sets this; kept for safety)
window.dataLayer = window.dataLayer || [];
window.gtag = window.gtag || function(){ dataLayer.push(arguments); };
function loadGTM() {
if (!window.gtagLoaded) {
window.gtagLoaded = true;
var script = document.createElement("script");
script.src = "https://www.googletagmanager.com/gtag/js?id=" + tC.internalvars.GA4_by_domain;
script.async = true;
document.head.appendChild(script);
gtag('js', new Date());
}
}
/* REMOVED: initializeConsent() and its onload hook — consent (default,
update, ads_data_redaction, url_passthrough) is owned by the sitewide
consent tag. NOTE: if url_passthrough is still wanted, it now lives in
the sitewide tag — see note below. */
function extractSearchVars() {
if(tc_vars.properties_searched[0].search_total_properties !== "0"){
var search_postcode = (tc_vars.properties && Array.isArray(tc_vars.properties) && tc_vars.properties.length > 0 && typeof tc_vars.properties[0].property_postcode !== 'undefined') 
? tc_vars.properties_searched[0].property_postcode 
: null;
var search_location_country = (tc_vars.properties && Array.isArray(tc_vars.properties) && tc_vars.properties.length > 0 && typeof tc_vars.properties[0].property_country !== 'undefined') 
? tc_vars.properties_searched[0].property_country 
: null;
var search_total_properties = (tc_vars.properties_searched && Array.isArray(tc_vars.properties_searched) && tc_vars.properties_searched.length > 0 && typeof tc_vars.properties_searched[0].search_total_properties !== 'undefined') 
? tc_vars.properties_searched[0].search_total_properties 
: null;
tc_vars.search_total_properties = search_total_properties || null;
}
}
function configurePageSettings() {
var pdp_config = tc_vars.pdp_config;
var prp_config = pdp_config || false;
if (!prp_config) {
setTimeout(function() {
gtag('config', tC.internalvars.GA4_by_domain, { send_page_view: false });
}, 2000);
prp_config = true;
tc_vars.prp_config = true;
}
}
function cleanUrl() {
var paramsToRemove = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', '_its', 'infinity', 'ID', 'locale'];
var url = new URL(window.location.href);
var searchParams = url.searchParams;
paramsToRemove.forEach(function(param) {
searchParams.delete(param);
});
var cleanUrl = url.origin + url.pathname;
if ([...searchParams].length > 0) {
cleanUrl += '?' + searchParams.toString();
}
if (url.hash) {
cleanUrl += url.hash;
}
tc_vars.GA4_pagelocation = cleanUrl;
}
function setContentGroup() {
/* ... unchanged — keep your full residentialSalesPaths /
commercialSalesPaths / residentialLettingsPaths /
commercialLettingsPaths arrays and the if/else chain
exactly as they are ... */
}
function captureUTMParams() {
var url = new URL(window.document.URL);
var utmParams = ["utm_source", "utm_medium", "utm_campaign", "utm_content"];
utmParams.forEach(function(param) {
var paramValue = url.searchParams.get(param);
tc_vars[param] = paramValue ? paramValue.replace("%20", " ") : "";
});
}
function sendPageView() {
var setCampaignParams = function(url, hasContent) {
var params = {
'id': tc_vars.campaign_id,
'source': tc_vars.utm_source,
'medium': tc_vars.utm_medium,
'name': tc_vars.utm_campaign
};
if (hasContent) {
params['campaign_content'] = tc_vars.utm_content;
}
gtag('set', 'campaign', params);
};
if (location.search.indexOf('utm_source') !== -1 && location.search.indexOf('utm_medium') !== -1 && location.search.indexOf('utm_campaign') !== -1) {
var url = new URL(window.document.URL);
setCampaignParams(url, location.search.indexOf('utm_content') !== -1);
}
setTimeout(function() {
gtag('event', 'page_view', {
/* ... unchanged — keep the full page_view payload exactly as-is,
including all Search* dimensions ... */
});
gtag('set', 'campaign', null);
}, 2500);
}
function runWhenIdle(fn) {
if ('requestIdleCallback' in window) {
requestIdleCallback(fn, { timeout: 3000 });
} else {
setTimeout(fn, 1000);
}
}
// Run everything
loadGTM();
runWhenIdle(function() {
extractSearchVars();
configurePageSettings();
cleanUrl();
setContentGroup();
captureUTMParams();
sendPageView();
tC.event.ga4_plp_view_item_list(null,{});
});
})();
}
});
