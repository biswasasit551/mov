tC.event.book_valuation_click(this, {});
}
if (text2.includes("a valuation")){
tC.event.book_valuation_click(this, {});
}
if (text2.includes("your local agent")){
tC.event.local_agent_click(this, {});
}
if (text2.includes("an agent")){
tC.event.local_agent_click(this, {});
}
});
});
