var cact_event_vars = Object.assign({}, tc_array_events);
var cact_event_attrs = cact_event.target || {};
// *** GA4 | Giosg Chat ***
var content_group = "";
if (tc_vars.env_template === "property_result"){
content_group = "Property Results"}
else if (tc_vars.env_template === "property_detail"){
content_group = "Property Listings"}
else if (tc_vars.env_template === "property_result" || tc_vars.env_template !== "property_detail"){
content_group = tc_vars.content_group}
if (window.gtag){
if(tc_array_events["event_action"] === "haschatted"){
gtag('event', "giosg_haschatted", {
send_to: tC.internalvars.GA4_by_domain,
'page_location': tc_vars.GA4_pagelocation,
'giosg_action': tc_array_events["event_action"]
});
}  
if(tc_array_events["event_action"] === "message sent"){
gtag('event', "giosg_message_sent", {
send_to: tC.internalvars.GA4_by_domain,
'page_location': tc_vars.GA4_pagelocation,
'giosg_action': tc_array_events["event_action"]
});
}  
if(tc_vars.page_engaged !== "Yes" && tc_array_events["event_action"] === "message sent"){
if (window.gtag){
var obj = {
send_to: tC.internalvars.GA4_by_domain,
'page_location': tc_vars.GA4_pagelocation,
'content_group': content_group,
'user_action': "Live Chat Clicked",
'day_number': tc_vars.day_number, 
'day_of_week': tc_vars.day_of_week, 
'hour_of_day': tc_vars.hour_of_day, 
'timezone_location': tc_vars.timezone_location
}
gtag("event","page_engagement", obj);
}}
tc_vars.page_engaged = "Yes"
}
}
});
