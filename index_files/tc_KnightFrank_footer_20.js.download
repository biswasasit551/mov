gtag('config', tC.internalvars.googleAds_by_domain);
// FIXED: plain domain strings — the markdown-linked "[domain](url)" versions
// could never match document.domain, so these configs never fired
if(window.document.domain === "www.knightfrank.com.au"){
gtag('config', 'AW-929776688');
}
if(window.document.domain === "www.knightfrank.ae"){
gtag('config', 'AW-17158792874');
}
if (window.document.domain === "www.knightfrank.es"){
gtag('config', 'AW-10801401973');
}
if (window.document.domain === "www.knightfrank.com.my"){
gtag('config', 'AW-10778299803');
}
},4000)
}
});
