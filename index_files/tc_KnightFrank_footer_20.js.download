// *** GA4 | Old CMS | Contact Agent #1 ***
cact('consent.get', function (result){
const analytics = 2;
const analyticsCategory2 = result.consent.categories[analytics] || {};
if (analyticsCategory2.status === 'on'){
if(tc_array_events["form_status"] === "form.open" && tc_array_events["form_name"] === "CMS - Contact Agent Form"){
tc_vars.lead_conversion = "no";
}
else if(tc_array_events["form_status"] === "form.submit.success" && tc_array_events["form_name"] === "CMS - Contact Agent Form"){
tc_vars.lead_conversion = "CMS Contact Agent"}
page_lookup = tc_vars.GA4_pagelocation;
(function (){
var page_path = ""
var page_location = ""
var ga4_event_name = ""
var send_to = ""
if(tc_array_events["form_status"] === "form.open" && tc_array_events["form_name"] === "CMS - Contact Agent Form"){
page_path = window.location.pathname+'/cms-contact-agent'
page_location = page_lookup
ga4_event_name = "cms_contact_agent_open"}
else if(tc_array_events["form_status"] === "form.submit.success" && tc_array_events["form_name"] === "CMS - Contact Agent Form"){
page_path = window.location.pathname+'/cms-contact-agent/thank-you'
page_location = page_lookup
ga4_event_name = "cms_contact_agent_submit"}
if(ga4_event_name === "cms_contact_agent_open" || ga4_event_name === "cms_contact_agent_submit"){
send_to = tC.internalvars.GA4_by_domain;}
if(window.gtag){
var obj = {
page_title: window.document.title,
page_location : page_location,
send_to : send_to,
'clientId': tc_vars.clientId,
"Platform": tC.internalvars.gtag_custom_dimension1,
"PageTimestamp": tC.internalvars.gtag_custom_dimension39,
"PageCategory": tC.internalvars.gtag_custom_dimension_46,
