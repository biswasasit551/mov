// *** GA4 | New CMS |  Navigation |  Sell Or Let Events ***
(function (window){
document.addEventListener("click", function (event){
var target = event.target || window.event.srcElement;
var findClosestByClass = function(el, className){
while (el && el !== document.body){
if (el.classList && el.classList.contains(className)){
return el;
}
el = el.parentNode;
}
return null;
};
var linkEl = findClosestByClass(target, "kf-a-link") || findClosestByClass(target, "kf-a-button");
if (!linkEl) return;
if (linkEl.classList.contains("kf-a-button--primary")) return;
var text = linkEl.textContent.trim();
if (text === "Sell or let"){
gtag('event', 'nav_sell_or_let_click', {});
return;
}
var selections = [
"Book your free valuation",
"Sell with us",
"London super prime",
"Country houses & estates",
"Waterfront homes",
"International",
"Sellers guide",
"Let with us",
"Short lettings",
"Super-prime lettings",
"Landlords guide"
];
if (selections.includes(text)){
// Convert text to snake_case for gtag event name
var eventName = text.toLowerCase()
.replace(/[^a-z0-9 ]/g, '')  // remove special characters
.replace(/\s+/g, '_');       // replace spaces with underscores
gtag('event', "nav_" + eventName + "_click", {});
}
});
})(window);
}
});
