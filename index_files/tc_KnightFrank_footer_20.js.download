// *** KF | Old CMS | Generic Event Calls | Container Loaded ***
(function(window, document) {
// ----------------------------
// SETUP VARIABLES
// ----------------------------
function initializeVariables() {
tc_vars.unique_id = tC.getCookie("ck_kf_id");
tc_vars.appraisal_form = "null";
if (document.querySelector(".seo-container")) {
tc_vars.seo_template = "SEO Page";
}
if (tc_vars.isOffice === "YES") {
tc_vars.isCMS = "YES";
}
if (tc_vars["env_domain"] === "www.knightfrankfinance.co.uk") {
tc_vars.env_template = "kf_finance";
}
}
function setDayAndQuarter() {
const now = new Date();
const startOfYear = new Date(now.getFullYear(), 0, 0);
const diff = (now - startOfYear) + ((startOfYear.getTimezoneOffset() - now.getTimezoneOffset()) * 60 * 1000);
const dayOfYear = Math.floor(diff / (1000 * 60 * 60 * 24));
const year = now.getFullYear();
const isLeap = year % 4 === 0 ? 1 : 0;
tc_vars.day_of_year = dayOfYear;
if (dayOfYear <= 89 + isLeap) {
tc_vars.quarter_of_year = `Q4 ${year - 1}/${year % 10}`;
} else if (dayOfYear <= 180 + isLeap) {
tc_vars.quarter_of_year = `Q1 ${year}/${(year % 10) + 1}`;
} else if (dayOfYear <= 272 + isLeap) {
tc_vars.quarter_of_year = `Q2 ${year}/${(year % 10) + 1}`;
} else {
tc_vars.quarter_of_year = `Q3 ${year}/${(year % 10) + 1}`;
}
}
// ----------------------------
// EVENT TRACKING HELPERS
// ----------------------------
function addClickTracking(selector, callback) {
const elements = document.querySelectorAll(selector);
elements.forEach(el => el.addEventListener("click", () => callback(el)));
}
function trackVCardClicks() {
addClickTracking('a[href*="vcard"]', el => {
tC.event.vCardClicks(el, { lead_triggered: "vCard" });
});
}
function trackWebinarClicks() {
addClickTracking('a[href^="https://event.on24.com"]', el => {
tC.event.il_web_webinar(el, { event_action: "Watch Webinar;" });
});
}
function trackPeoplePageInteractions() {
if (tc_vars["env_template"] !== "People Pages") return;
addClickTracking('a[class*="contact-agent-button"]', el => {
tC.event.form_interaction(el, {
form_status: "form.open",
form_name: "CMS - Contact Agent Form"
});
});
if (tc_vars["tc_pathname"] === "/contact/people/search") {
addClickTracking('a[class*="btnModalEmployeeForm"]', el => {
tC.event.form_interaction(el, {
form_status: "form.open",
form_name: "CMS - Contact Agent Form"
});
});
addClickTracking('div[class*="close"], button[class*="close"]', el => {
tC.event.form_interaction(el, {
form_status: "close-modal"
});
});
}
}
function trackValuationFormSubmit() {
if (tc_vars["tc_pathname"] !== "/how-much-is-your-home-worth") return;
addClickTracking('button[class*="contact-submit"]', el => {
tC.event.property_valuation(el, {
form_name: "Property Valuation",
form_status: "form.submit.success"
});
});
}
function trackIframeFormSubmit() {
addClickTracking('input[id*="cpMain_ucc1_ctl00_btnSubmit"]', el => {
tC.event.iframe_generic_form(el, {
form_name: "iFrame Generic Form",
form_status: "form.submit.success"
});
});
}
function trackReportDownload() {
const buttons = document.querySelectorAll('a.report-download-button.submit-button');
function handler() {
tC.event.rl_subscription_button_click(null, {});
}
buttons.forEach(btn => {
btn.removeEventListener("click", handler);
btn.addEventListener("click", handler);
});
}
function trackPhoneClicks() {
document.addEventListener("click", function(event) {
if (window.scriptTriggered) return;
const link = event.target.closest("a");
if (!link) return;
const href = link.getAttribute("href") || "";
const title = link.getAttribute("title") || "";
const isTel = href.startsWith("tel:");
const is020 = title.startsWith("020");
const number = href.replace("tel:", "") || title;
if (isTel || is020) {
const device = tC?.internalvars?.device || "desktop";
tC.event.phoneClicks(link, {
lead_triggered: device === "desktop" ? "Phone Click - Desktop" : "Phone Call",
form_action: "Telephone",
telephone_number: number,
env_template: tc_vars["env_template"],
device_type: device
});
window.scriptTriggered = true;
}
});
}
// ----------------------------
// INITIALIZE
// ----------------------------
function init() {
initializeVariables();
setDayAndQuarter();
trackVCardClicks();
trackWebinarClicks();
trackPeoplePageInteractions();
trackValuationFormSubmit();
trackIframeFormSubmit();
trackReportDownload();
trackPhoneClicks();
}
init();
})(window, document);
}
}
}
}
}
}
