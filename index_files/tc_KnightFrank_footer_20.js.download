function trackViewContentEvent() {
var propertyReference = window.location.pathname.split('/')[5];
var rsi = propertyReference.includes("rsi");
var range1 = parseFloat(tC.internalFunctions.tc_function_16(tc_vars["property_details"],',','property_price_min') * 0.75).toFixed(2);
var range2 = parseFloat(tC.internalFunctions.tc_function_16(tc_vars["property_details"],',','property_price_min') * 1.25).toFixed(2);
var propertyType = getPropertyType();
var pixelId = getPixelId();
if (pixelId) {
fbq('trackSingle', pixelId, 'ViewContent', {
availabilty: tC.internalFunctions.tc_function_16(tc_vars["property_details"],',','property_transaction') === "Sales" ? "for_sale" : "for_rent",
currency: tC.internalFunctions.tc_function_16(tc_vars["property_details"],',','property_currency'),
content_type: 'home_listing',
content_ids: propertyReference.toLowerCase(),
city: tC.internalFunctions.tc_function_16(tc_vars["property_details"],',','property_city'),
region: tC.internalFunctions.tc_function_16(tc_vars["property_details"],',','property_county'),
country: tC.internalFunctions.tc_function_16(tc_vars["property_details"],',','property_country_IsoCode'),
listing_type: tC.internalFunctions.tc_function_16(tc_vars["property_details"],',','property_transaction') === "Sales" ? "for_sale_by_agent" : "for_rent_by_agent",
preferred_price_range: [range1, range2],
preferred_baths_range: [1, parseInt(tC.internalFunctions.tc_function_16(tc_vars["property_details"],',','property_bathrooms'), 10)],
preferred_beds_range: [1, parseInt(tC.internalFunctions.tc_function_16(tc_vars["property_details"],',','property_bedrooms'), 10)],
property_type: propertyType
});
}
}
function getPropertyType() {
var type = tC.internalFunctions.tc_function_16(tc_vars["property_details"],',','property_type').toLowerCase();
if (type.includes("apartment")) return "apartment";
if (type.includes("house")) return "house";
if (type.includes("penthouse")) return "penthouse";
if (type.includes("studio")) return "studio";
return "other";
}
function getPixelId() {
if ((tc_vars["env_domain"] === "www.knightfrank.co.uk" || tc_vars["env_domain"] === "www.knightfrank.com" || tc_vars["env_domain"] === "www.knightfrank.us") && tC.internalFunctions.tc_function_16(tc_vars["property_details"],',','property_division') === "Residential") {
return '1214123878709190';
}
if (tc_vars["env_domain"] === "beta.knightfrank.co.uk" && tC.internalFunctions.tc_function_16(tc_vars["property_details"],',','property_division') === "Residential") {
return '847469920064726';
}
if (tc_vars["env_domain"] === "www.knightfrank.com.au" && tC.internalFunctions.tc_function_16(tc_vars["property_details"],',','property_division') === "Residential") {
return '1280304085745226';
}
return '';
}
// ---- FIXED LOGIC: fire pixel immediately, if not already fired ----
if (!fbPixelFired) {
initializeFacebookPixel();
fbPixelFired = true;
if (tc_vars["env_template"] === "property_detail") {
trackViewContentEvent();
}
}
}
});
