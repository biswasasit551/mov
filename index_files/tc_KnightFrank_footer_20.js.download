executeTag1351_4398_20: function (el, p){
if (!el||!el.target){el={type:"no_event",target:{}}};
if(typeof p=="undefined"){p={};}
tc_array_events = tC.container_4398_20.init_tc_array_events(p);
var cact = tC.container_4398_20.cact || window.cact;
var cact_container = window.tC_4398_20;
var cact_event = el || {};
var cact_event_vars = Object.assign({}, tc_array_events);
var cact_event_attrs = cact_event.target || {};
// *** Infinity | UK | Extract GA4 User Pseudo ID & Session ID ***
setTimeout(function(){
var getCookieValue = function(name){
var cookies = document.cookie.split(';');
for (var i = 0; i < cookies.length; i++){
var cookie = cookies[i].trim();
if (cookie.startsWith(name + '=')){
return cookie.substring(name.length + 1);
}
}
return null;
};
var getUserPseudoId = function(){
var gaCookie = getCookieValue('_ga');
if (gaCookie){
var parts = gaCookie.split('.');
if (parts.length === 4){
return parts[2] + '.' + parts[3];
}
}
return null;
};
var getSessionId = function(measurementId){
const cookieName = `_ga_${measurementId}`;
const gaCookie = getCookieValue(cookieName);
if (gaCookie && gaCookie.startsWith("GS2.1.")){
const parts = gaCookie.split('.');
if (parts.length > 2){
const sessionSegment = parts[2]; // s<session_id>$...
const match = sessionSegment.match(/^s(\d+)/);
if (match && match[1]){
return match[1]; // Extracted session ID
}
}
}
return null;
};
var checkAndLoadInfinity = function(attempt = 0){
var userPseudoId = getUserPseudoId();
var sessionId = null;
var measurementId = null;
try {
if (tC && tC.internalvars && tC.internalvars.GA4_by_domain){
measurementId = tC.internalvars.GA4_by_domain;
if (measurementId === tC.internalvars.GA4_by_domain){
// Check if it matches the required ID
sessionId = getSessionId(measurementId.replace("G-", ""));
}
}
} catch (error){
sessionId = null;
}
// Assign values
const now1 = Date.now();
tc_vars.user_pseudo_id = userPseudoId;
tc_vars.ga_session_id = sessionId;
sessionStorage.setItem('stored_timestamp', now1);
sessionStorage.setItem('ga_session_id', sessionId);
// Check if both variables are available before loading Infinity script
if (userPseudoId && sessionId){
loadInfinityScript();
} else if (attempt < 10){
setTimeout(() => checkAndLoadInfinity(attempt + 1), 2000); // Retry every 500ms, max 10 times
}
};
var loadInfinityScript = function(){
window._its('setVariable', 'user_pseudo_id', String(tc_vars.user_pseudo_id));
window._its('setVariable', 'ga_session_id', String(tc_vars.ga_session_id));
};
// Start checking for variable readiness
checkAndLoadInfinity();
}, 4000);
}
});
