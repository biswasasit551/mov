if(tC.getCookie(tC.privacy.getCN()) != ''){
if(tC.privacy.validRules('1507')){
tC.launchTag(1507, 'Consent Mode Settings - Sitewide', 26, 4398, 20, 9);
// *** Consent Mode Settings - Sitewide ***
// =====================================================================
// Consent Mode Owner ??" the ONLY place consent is set on this site
// Replaces: cact-based sitewide reader, per-config-tag consent blocks
// NB: category IDs are hard-coded below (analytics = 2, marketing = 3)
//     ??" verify against the banner config before renumbering categories
// =====================================================================
// 1. Global gtag stub ??" safe before gtag.js loads; commands queue
window.dataLayer = window.dataLayer || [];
window.gtag = window.gtag || function(){
dataLayer.push(arguments); };
// 2. Denied default, once, as early as possible
if (!window?.google_tag_data?.ics?.usedDefault) {
gtag("consent", "default", {
ad_storage: "denied",
analytics_storage: "denied",
ad_user_data: "denied",
ad_personalization: "denied",
personalization_storage: "denied",
functionality_storage: "denied",
security_storage: "denied",
wait_for_update: 2250
});
}
// 3. Read consent straight from the footer container's privacy object.
//    Do NOT use cact() as the primary transport ??" the cact command queue
//    can be answered by the header container, whose consent state never
//    resolves on Old CMS templates (/offices, estate-agents), which is
//    why consent silently failed there.
var kfApplyConsent = function(){
var c;
try { c = tC.privacy.getConsent({ pretty: true }); } catch(e){
return false; }
if (!c || !c.consent || c.consent.status === 'unset') return false;
var cats = c.consent.categories || {};
var mkt = cats[3] || {};   // marketing
var ana = cats[2] || {};   // analytics
tc_vars.ad_storage = tc_vars.ad_user_data = tc_vars.ad_personalization =
(mkt.status === 'on') ? "granted" : "denied";
tc_vars.ads_data_redaction = (mkt.status !== 'on');
tc_vars.analytics_storage = (ana.status === 'on') ? "granted" : "denied";
tc_vars.send_pageview = tc_vars.analytics_storage === "granted";
gtag("consent", "update", {
ad_storage: tc_vars.ad_storage,
analytics_storage: tc_vars.analytics_storage,
ad_user_data: tc_vars.ad_user_data,
ad_personalization: tc_vars.ad_personalization,
personalization_storage: "granted",
functionality_storage: "granted",
security_storage: "granted"
});
gtag('set', 'ads_data_redaction', tc_vars.ads_data_redaction);
window.consent_mode_deployed = true;
return true;
};
// 4. Apply now; if the privacy file hasn't loaded yet, retry until it has
if (!kfApplyConsent()){
var kfConsentPoll = setInterval(function(){
if (kfApplyConsent()) clearInterval(kfConsentPoll);
}, 400);
setTimeout(function(){
clearInterval(kfConsentPoll); }, 20000);
}
// 5. Re-apply on banner interactions
//    (container events are the reliable channel; cact kept as backup)
try { tC.eventTarget.addEventListener('consent-update', kfApplyConsent); } catch(e){
}
try { tC.eventTarget.addEventListener('consent-ready',  kfApplyConsent); } catch(e){
}
try { cact('consent.onUpdate', kfApplyConsent); } catch(e){
}
}
}
