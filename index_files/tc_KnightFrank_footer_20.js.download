var cact = tC.container_4398_20.cact || window.cact;
var cact_container = window.tC_4398_20;
var cact_event = el || {};
var cact_event_vars = Object.assign({}, tc_array_events);
var cact_event_attrs = cact_event.target || {};
// *** GA4 | Event | New PLP & PDP Page Engagement Event ***
;(function (window){
// Initialize global state once
if (!window.__engagementScriptInitted){
window.__engagementScriptInitted = true;
window.__engagementScriptState = {
engagementTimeouts: {},
listeners: {},
engagedPerPage: {},
currentKey: null
};
}
// Template calls
const TEMPLATES = ['property_result', 'property_detail'];
const state = window.__engagementScriptState;
// Global cleanupAll: removes all listeners/timeouts
var cleanupAll = function(){
for (const key in state.listeners){
cleanup(key);
}
};
// Remove listeners/timeouts for a specific key
var cleanup = function(key){
const entry = state.listeners[key];
if (entry){
document.removeEventListener('click', entry.clickHandler, true);
window.removeEventListener('scroll', entry.scrollHandler);
clearTimeout(state.engagementTimeouts[key]);
delete state.listeners[key];
delete state.engagementTimeouts[key];
}
};
var setupEngagementFor = function(template, key){
// Avoid double-engagement on same page
if (state.engagedPerPage[key]) return;
// Clean up any previous page listeners
cleanupAll();
const content_group = window.tc_vars.content_group;
const page_location = window.tc_vars.GA4_pagelocation;
// Throttle scroll state
let prevScrollPercent = 0;
let scrollScheduled = false;
var getTrackLength = function(){
const doc = document.documentElement;
return Math.max(doc.scrollHeight, doc.offsetHeight, doc.clientHeight) - window.innerHeight;
}
var getScrollTop = function(){
return window.pageYOffset || document.documentElement.scrollTop || document.body.scrollTop || 0;
}
var checkScroll = function(){
const percent = Math.floor((getScrollTop() / getTrackLength()) * 100);
if (percent >= 25 && prevScrollPercent < 25){
markEngaged('Scroll > 25%');
}
prevScrollPercent = percent;
}
var scrollHandler = function(){
if (!scrollScheduled){
scrollScheduled = true;
requestAnimationFrame(() => {
checkScroll();
scrollScheduled = false;
});
}
}
var clickHandler = function(e){
const selector = `
[class*="kf"], [class*="button"], button[class*="ng-star-inserted"],
a[class*="division-link"], a[class*="js-sidebar-open"], div[class*="js-sidebar-open"],
input[id*="txtSearch"], a[href*="/"], a[href*=".pdf"], button[class*="btn"],
button[data-link*="enquiry form"], button[class*="search-button"],
a[class*="property-listing"], button[class*="tc-stamp-duty-button"],
.container-item, .grid-address, .ng-star-inserted, .txtSearch, a, button, input
`;
if (e.target.closest(selector)){
// delay to avoid accidental taps
setTimeout(() => markEngaged('CTA Clicked'), 7000);
}
}
var engagementData = function(action){
return {
send_to: window.tC.internalvars.GA4_by_domain,
'page_location': window.location.origin + window.location.pathname,
//   'content_group': tc_vars.content_group,
user_action: action,
//    env_template: template,
day_number: window.tc_vars.day_number,
day_of_week: window.tc_vars.day_of_week,
hour_of_day: window.tc_vars.hour_of_day,
timezone_location: window.tc_vars.timezone_location
};
}
var markEngaged = function(action){
if (state.engagedPerPage[key]) return;
gtag('event', 'page_engagement', engagementData(action));
state.engagedPerPage[key] = true;
cleanup(key);
}
// Attach listeners & timeouts
document.addEventListener('click', clickHandler, true);
window.addEventListener('scroll', scrollHandler, { passive: true });
state.listeners[key] = { clickHandler, scrollHandler };
};
// Poll for template/page changes
const poll = setInterval(() => {
const tpl = window.tc_vars && window.tc_vars.env_template;
if (!tpl || !TEMPLATES.includes(tpl)) return;
const pageKey = `${tpl}::${window.location.pathname}${window.location.search}`;
if (state.currentKey !== pageKey){
state.currentKey = pageKey;
setupEngagementFor(tpl, pageKey);
}
}, 300);
})(window);
}
});
