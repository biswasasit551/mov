tC.extend({
executeTag840_4398_20: function (el, p){
if (!el||!el.target){el={type:"no_event",target:{}}};
if(typeof p=="undefined"){p={};}
tc_array_events = tC.container_4398_20.init_tc_array_events(p);
var cact = tC.container_4398_20.cact || window.cact;
var cact_container = window.tC_4398_20;
var cact_event = el || {};
var cact_event_vars = Object.assign({}, tc_array_events);
var cact_event_attrs = cact_event.target || {};
// *** GA4 | Event | Stamp Duty Calculator ***
if (window.location.href.includes("gclid")) {
page_lookup = window.location.href;
} else {
page_lookup = 'https://' + window.location.hostname + window.location.pathname;
}
setTimeout(function (){
(function () {
var input = document.querySelector(".js-price-format").value;
var buyer_type = "";
var overseasBuyer = document.querySelector("#overseasBuyer").checked;
var firstHomeNew = document.querySelector("#firstHomeNew").checked;
var secondHomeNew = document.querySelector("#secondHomeNew").checked;
var amountToPayNew = document.querySelector("#amountToPayNew").textContent;
var effectiveRateNew = document.querySelector("#effectiveRateNew").textContent;
var x = Number(document.querySelector(".js-price-format").value.replace(/,/g, ''));
var output = "";
if (x >= 0 && x < 125000) {
output = "£0 to £125,000";
} else if (x >= 125000 && x < 250000) {
output = "£125,000 to £250,000";
} else if (x >= 250000 && x < 925000) {
output = "£250,000 to £925,000";
} else if (x >= 925000 && x < 1500000) {
output = "£925,000 to £1,500,000";
} else if (x >= 1500000) {
output = "Over £1,500,000";
}
if (!overseasBuyer && !firstHomeNew && !secondHomeNew) {
buyer_type = "";
} else if (overseasBuyer && !firstHomeNew && !secondHomeNew) {
buyer_type = "Overseas Buyer";
} else if (overseasBuyer && firstHomeNew && !secondHomeNew) {
buyer_type = "Overseas Buyer - First Time Buyer";
} else if (overseasBuyer && !firstHomeNew && secondHomeNew) {
buyer_type = "Overseas Buyer - Second Home/Buy To Let";
} else if (!overseasBuyer && firstHomeNew && !secondHomeNew) {
buyer_type = "UK Buyer - First Time Buyer";
} else if (!overseasBuyer && !firstHomeNew && secondHomeNew) {
buyer_type = "UK Buyer - Second Home/Buy To Let";
}
var obj = {
buyer_category: buyer_type,
input_amount: "£" + input,
output_amount: output,
amount_to_pay: amountToPayNew,
rate_value: effectiveRateNew,
send_to: tC.internalvars.GA4_by_domain,
page_location: page_lookup,
landing_page_domain: tc_vars.landing_page_domain,
landing_page_path1: tc_vars.landing_page_path1,
landing_page_path2: tc_vars.landing_page_path2,
landing_page_content_group: tc_vars.landing_page_content_group
};
if (!overseasBuyer && !firstHomeNew && !secondHomeNew) {
if (window.gtag) {
gtag("event", "stamp_duty_calculator", obj);}
} else if (overseasBuyer && !firstHomeNew && !secondHomeNew) {
gtag("event", "stamp_duty_calculator", obj);
} else if (overseasBuyer && firstHomeNew && !secondHomeNew) {
gtag("event", "stamp_duty_calculator", obj);
} else if (overseasBuyer && !firstHomeNew && secondHomeNew) {
gtag("event", "stamp_duty_calculator", obj);
} else if (!overseasBuyer && firstHomeNew && !secondHomeNew) {
gtag("event", "stamp_duty_calculator", obj);
} else if (!overseasBuyer && !firstHomeNew && secondHomeNew) {
gtag("event", "stamp_duty_calculator", obj);
}
})();
}, 2000);
}
});
