var cact_event = el || {};
var cact_event_vars = Object.assign({}, tc_array_events);
var cact_event_attrs = cact_event.target || {};
// *** KF | Generic Event Calls | PDP (New) ***
for (var i = 0; i < window.dataLayer.length; i++) {
var item = window.dataLayer[i];
// Check if item is an object or array
if (isObjectOrArray(item)) {
// Check each property or element of item
var shouldRemove = false;
for (var key in item) {
if (item.hasOwnProperty(key) && typeof item[key] === 'string' && item[key].startsWith('G-')) {
shouldRemove = true;
break; // Exit the loop since we found a matching property
}
}
// Remove the item if any property or element starts with 'G-'
if (shouldRemove) {
window.dataLayer.splice(i, 1);
i--; // Adjust index because we removed an element
}
}
}
function isObjectOrArray(item) {
return (typeof item === 'object' && item !== null) || Array.isArray(item);
}
(function(window){
if (window.scriptTriggeredPDP){
return; // Exit the function if already triggered
}
document.addEventListener('click', function(event){
const target = event.target;
const link = findClosestLink(target);
if (link){
const classList = link.classList;
if (
classList.contains('pdp-share') ||
classList.contains('gl-share-facebook') ||
classList.contains('gl-share-linkedin') ||
classList.contains('gl-share-twitter') ||
classList.contains('gl-share-email') ||
classList.contains('gl-share-copy-link')
){
tC.event.share_property(this, {
share_button: target.textContent,
property_reference: tC.internalFunctions.tc_function_16(tc_vars["property_details"],',','property_reference')
});
}
if (classList.contains('pdp-carousel-open')){
var c = document.querySelector("span.pdp-carousel-pagingInfo").textContent.substring(0, 2);
tC.event.form_event_pdp_carousel_open(this, {
click_event: "pdp-carousel-open",
page_number: c,
property_reference: tC.internalFunctions.tc_function_16(tc_vars["property_details"],',','property_reference')
});
}
// clicks on Buy To Let Yield Mortgage Calculator on PDP
if (target.closest('.btly-calc-button.submit')){
tC.event.pdp_btly_calculator(null, {});
}
// clicks on Stamp Duty Calculator on PDP
if (target.closest('#stampDutyForm > div > div.row > form > div:nth-child(5) > button.submit.col-md-12')){
tC.event.pdp_stamp_duty_calculator(null, {});
}
// clicks on Mortgage Calculator on PDP
if (target.closest('.stamp-calc-button.submit')){
tC.event.pdp_mortgage_calculator(null, {});
}
// clicks on 'Back to Search' on PDP
if (target.closest('.back-to-search')){
tC.event.pdp_back_to_search(null, {});
}
// clicks on 'Previous Property' on PDP
if (target.closest('.prev-property')){
tC.event.pdp_previous_property(null, {});
}
// clicks on 'Next Property' on PDP
if (classList.contains('next-property')){
tC.event.pdp_next_property(null, {});
}
// clicks on 'Brochure' on PDP
if (classList.contains('property-brochure')){
tC.event.property_brochure(null, {});
}
// clicks on 'View More Properties In' on PDP
if (link.href && link.href.includes("/all-types/all-beds")){
tC.event.pdp_view_more_property(null, {});
}
