// *** New CMS | Standard Page Form Clicks & Inputs ***
(function(window){
// Ensure handler functions are globally consistent across reloads
window._tc_handleInput1 = window._tc_handleInput1 || function() {
if (this.value.trim() !== "") {
tC.event.standard_page_contact_form_input(this, {
form_status: "form.input",
cms_form_type: tc_vars.cms_form_type,
