// *** KF | Old CMS | PDF Download/Save Report Calls | Research Library ***
(function (window){
document.addEventListener("click", function (event){
if (!event){
event = window.event; // For older versions of Internet Explorer
}
var target = event.target || event.srcElement;
if (event.target.tagName === "A" && event.target.getAttribute("href") && event.target.getAttribute("href").endsWith(".pdf")){
e._g = true;
tC.event.pdf_download2(this, {
event: "page_pdf_download",
pdf_download_button: "download",
pdf_site_section: "Research - Report Library",
pdf_name: tC.kf.getPageNameByFullUrl(event.target.href)
});
}
