// *** New CMS | Office Page Form Inputs ***
(function (window){
var waitForInput1 = function(){
var input1 = document.getElementById("1e44e84b-0584-4b6e-8079-2755b6bd9850")
if (!input1){
setTimeout(waitForInput1, 300);
return;
}
var handleInput1 = function(){
var value1 = input1.value.trim();
if (value1 !== ""){
if (tc_vars["env_template"] === "Residential Office Contact Form") {
tC.event.residential_office_form_input(this, { form_status: "form.input" });
}
if (tc_vars["env_template"] === "Commercial Office Contact Form") {
tC.event.commercial_office_form_input(this, { form_status: "form.input" });
}
input1.removeEventListener("input", handleInput1); // Corrected
}
};
input1.addEventListener("input", handleInput1); // Corrected
};
waitForInput1();
var waitForInput2 = function(){
var input2 = document.getElementById("7bb8d468-04e6-437e-bb9c-425438f21b3a") 
if (!input2){
setTimeout(waitForInput2, 300);
return;
}
var handleInput2 = function(){
var value2 = input2.value.trim();
if (value2 !== ""){
if (tc_vars["env_template"] === "Residential Office Contact Form") {
tC.event.residential_office_form_message(this, { form_status: "form.message" });
}
if (tc_vars["env_template"] === "Commercial Office Contact Form") {
tC.event.commercial_office_form_message(this, { form_status: "form.message" });
}
input2.removeEventListener("input", handleInput2); // Corrected
}
};
input2.addEventListener("input", handleInput2); // Corrected
};
waitForInput2();
})(window);
}
});
