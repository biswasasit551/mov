// *** GA4 | E-Commerce Events | PLP | View Item List ***
setTimeout(function() {
if (window.gtag && tc_vars && Array.isArray(tc_vars.property_details)) {
var items = tc_vars.property_details.slice(0, 10).map(function(detail) {
if (!detail) return null; // Handle missing entries safely
return {
item_id: detail.property_reference || null,
item_category: detail.property_type?.[0] || null,
item_category2: detail.property_amenities?.[0] || null,
item_category3: detail.property_bathrooms ? detail.property_bathrooms + " Bathrooms" : null,
item_category4: detail.property_bedrooms ? detail.property_bedrooms + " Bedrooms" : null,
location_id: detail.property_postcode || null,
price: detail.property_price_min || null,
quantity: 1
};
}).filter(Boolean); // Remove any 'null' entries caused by missing details
gtag("event", "view_item_list", {
item_list_id: "property_search_results",
item_list_name: tc_vars.properties_searched?.[0]?.search_keywords || null,
content_group: tc_vars.content_group || null,
items: items
});
}
}, 4000);
}
});
