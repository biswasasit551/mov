});
removeInputListener(this, window._tc_handleInput1);
}
};
window._tc_handleInput2 = window._tc_handleInput2 || function() {
if (this.value.trim() !== "") {
tC.event.standard_page_contact_form_message(this, {
form_status: "form.message",
cms_form_type: tc_vars.cms_form_type,
agent_name: tc_vars.agent_name,
agent_title: tc_vars.agent_title,
agent_office_name: tc_vars.agent_office_name,
env_template: tc_vars.page_name,
page_name: tc_vars.page_name,
page_category: tc_vars.page_category,
