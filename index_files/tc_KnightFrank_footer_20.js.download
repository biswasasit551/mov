page_name: tc_vars.page_name,
page_category: tc_vars.page_category,
page_subcategory: tc_vars.page_subcategory,
page_division: tc_vars.page_division,
page_transaction: tc_vars.page_transaction
});
removeClickListener(this, window._tc_handleClick1);
};
// Helpers
var attachInputListener = function(input, handler) {
if (input) {
// Always remove before adding to avoid duplicates
input.removeEventListener('input', handler);
input.addEventListener('input', handler);
input._listenerAttached = true;
}
};
var removeInputListener = function(input, handler) {
if (input) {
input.removeEventListener('input', handler);
input._listenerAttached = false;
}
};
var attachClickListener = function(click, handler) {
if (click) {
// Always remove before adding to avoid duplicates
click.removeEventListener('click', handler);
click.addEventListener('click', handler);
click._listenerAttached = true;
}
};
var removeClickListener = function(click, handler) {
if (click) {
click.removeEventListener('click', handler);
click._listenerAttached = false;
}
};
// Track previous input elements to remove listeners on DOM change
let input1 = null, input2 = null, click1 = null;
// Observe DOM changes to detect modal open/close
const observer = new MutationObserver(() => {
let newInput1 = document.getElementById("1e44e84b-0584-4b6e-8079-2755b6bd9850");
let newInput2 = document.getElementById("7bb8d468-04e6-437e-bb9c-425438f21b3a");
let newClick1 = document.querySelector(".kf-m-contact-form-person__info__link");
// Remove listeners from old elements if they changed
if (input1 && input1 !== newInput1) {
removeInputListener(input1, window._tc_handleInput1);
}
if (input2 && input2 !== newInput2) {
removeInputListener(input2, window._tc_handleInput2);
}
if (click1 && click1 !== newClick1) {
removeClickListener(click1, window._tc_handleClick1);
}
// Attach listeners to new elements
if (newInput1) {
attachInputListener(newInput1, window._tc_handleInput1);
}
if (newInput2) {
attachInputListener(newInput2, window._tc_handleInput2);
}
if (newClick1) {
attachClickListener(newClick1, window._tc_handleClick1);
}
// Update references
input1 = newInput1;
input2 = newInput2;
click1 = newClick1;
});
observer.observe(document.body, { childList: true, subtree: true });
})(window);
}
});
