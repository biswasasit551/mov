window.lintrk('track', { conversion_id: 17590586 });
}
});
// Function to find the closest link or specified element
var findClosestLink = function(element){
if (
element.tagName === 'A' ||
element.tagName === 'BUTTON' ||
element.tagName === 'DIV' ||
element.tagName === 'SPAN' 
){
return element;
} else if (element.parentNode){
return findClosestLink(element.parentNode);
} else {
return null;
}
};
window.scriptTriggered = true;
})(window);
}
