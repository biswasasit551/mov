tC.extend({
executeTag1003_4398_20: function (el, p){
if (!el||!el.target){el={type:"no_event",target:{}}};
if(typeof p=="undefined"){p={};}
tc_array_events = tC.container_4398_20.init_tc_array_events(p);
var cact = tC.container_4398_20.cact || window.cact;
var cact_container = window.tC_4398_20;
var cact_event = el || {};
var cact_event_vars = Object.assign({}, tc_array_events);
var cact_event_attrs = cact_event.target || {};
// *** DOM Ready - Page Engagement ***
(function () {
if (tc_vars.page_engaged === "Yes") return;
const content_group = tc_vars.content_group;
const page_lookup = tc_vars.GA4_pagelocation;
const buttonSelector = `
[class*="kf"],
a[class*="button"],
button[class*="ng-star-inserted"],
a[class*="division-link"],
a[class*="js-sidebar-open"],
div[class*="js-sidebar-open"],
input[id*="txtSearch"],
a[href*="/"],
a[href*=".pdf"],
button[class*="btn"],
button[data-link*="enquiry form"],
button[class*="search-button"],
a[class*="property-listing"],
button[class*="tc-stamp-duty-button"]
`;
const buttons = document.querySelectorAll(buttonSelector);
const numButtons = buttons.length;
let pageEngaged = false;
let previousScrollPercent = 0;
const engagementData = (action) => ({
send_to: tC.internalvars.GA4_by_domain,
page_location: page_lookup,
content_group,
user_action: action,
day_number: tc_vars.day_number,
day_of_week: tc_vars.day_of_week,
hour_of_day: tc_vars.hour_of_day,
timezone_location: tc_vars.timezone_location,
});
function markEngaged(action) {
if (tc_vars.page_engaged !== "Yes") {
gtag("event", "page_engagement", engagementData(action));
tc_vars.page_engaged = "Yes";
cleanup();
}
}
function cleanup() {
buttons.forEach((btn) => btn.removeEventListener("click", clickHandler));
window.removeEventListener("scroll", throttledScrollHandler);
clearTimeout(engagementTimeout);
}
function getTrackLength() {
const body = document.body;
const html = document.documentElement;
return Math.max(
body.scrollHeight,
html.scrollHeight,
body.offsetHeight,
html.offsetHeight,
body.clientHeight,
html.clientHeight
) - window.innerHeight;
}
function getScrollTop() {
return window.pageYOffset || document.documentElement.scrollTop || document.body.scrollTop || 0;
}
function checkScroll() {
const scrollTop = getScrollTop();
const trackLength = getTrackLength();
const percent = Math.floor((scrollTop / trackLength) * 100);
if (percent >= 50 && previousScrollPercent < 50) {
markEngaged("Scroll > 50%");
}
previousScrollPercent = percent;
}
// Throttle scroll check to ~250ms using requestAnimationFrame
let scrollTimeout;
function throttledScrollHandler() {
if (!scrollTimeout) {
scrollTimeout = true;
requestAnimationFrame(() => {
checkScroll();
scrollTimeout = false;
});
}
}
function clickHandler() {
if (tc_vars.page_engaged !== "Yes") {
setTimeout(() => {
markEngaged("CTA Clicked");
}, 7000);
}
}
// Setup CTA click tracking
buttons.forEach((btn) => {
btn.addEventListener("click", clickHandler, { once: true });
});
// Setup scroll engagement
window.addEventListener("scroll", throttledScrollHandler, { passive: true });
// Setup timeout engagement after 57 seconds
const engagementTimeout = setTimeout(() => {
markEngaged("> 60 Seconds");
}, 57000);
})();
}
});
