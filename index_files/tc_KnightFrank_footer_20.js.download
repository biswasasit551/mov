// *** GA4 | New CMS | Yext Contact Forms | Residential Offices ***
var getIdValues = function(url = window.location.href) {
const urlParams = new URLSearchParams(new URL(url).search);
return Array.from(urlParams.entries())
.filter(([key, _]) => key.endsWith("id"))
.map(([_, value]) => value);
};
tc_vars.office_form_id = getIdValues()[0];
if (window.tc_vars.env_template === "Residential Office Contact Form") {
const url = window.document.URL;
const hasLetting = url.match(/[?&](let_id|let-id)=/);
const hasSales = url.match(/[?&](sales_id|sale-id)=/);
const hasJustId = url.match(/[?&](office_id|id)=/);
if (hasLetting && hasSales) {
window.tc_vars["office_form_type"] = "residential_office";
} else if (hasJustId) {
window.tc_vars["office_form_type"] = "residential_intent_office";
} else if (hasLetting) {
window.tc_vars["office_form_type"] = "residential_letting_office";
} else if (hasSales) {
window.tc_vars["office_form_type"] = "residential_sales_office";
}
}
